<?xml version="1.0"?>
<package format="3">
  <name>amr_navigation</name><version>0.1.0</version>
  <description>Odometry, localization, SLAM and Nav2 integration for Guide AMR.</description>
  <maintainer email="team@example.com">Kookmin Robotics</maintainer><license>Apache-2.0</license>
  <buildtool_depend>ament_python</buildtool_depend>
  <exec_depend>rclpy</exec_depend><exec_depend>amr_interfaces</exec_depend>
