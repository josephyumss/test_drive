<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="guide_amr">
  <link name="base_link">
    <visual><geometry><box size="0.60 0.50 0.25"/></geometry></visual>
    <collision><geometry><box size="0.60 0.50 0.25"/></geometry></collision>
    <inertial><mass value="20.0"/><origin xyz="0 0 0"/><inertia ixx="0.47" ixy="0" ixz="0" iyy="0.75" iyz="0" izz="0.82"/></inertial>
  </link>
  <link name="laser_link"/>
  <joint name="laser_joint" type="fixed"><parent link="base_link"/><child link="laser_link"/><origin xyz="0.20 0 0.25"/></joint>
  <link name="imu_link"/>
  <joint name="imu_joint" type="fixed"><parent link="base_link"/><child link="imu_link"/><origin xyz="0 0 0.12"/></joint>
  <link name="camera_link"/>
  <joint name="camera_joint" type="fixed"><parent link="base_link"/><child link="camera_link"/><origin xyz="0.25 0 0.35"/></joint>
</robot>
