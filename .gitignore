.DS_Store
__pycache__/
*.py[cod]
.pytest_cache/
.venv/
venv/

# ROS2 / colcon
jetson_ws/build/
jetson_ws/install/
jetson_ws/log/

# Build products and logs
*.o
*.elf
*.hex
*.bin
*.map
*.log

# Full-run diagnostics are shared through Git (raw logs and debug archives).
# Keep unrelated logs ignored, but allow BOTH full-run folders recursively.
/logs/*
!/logs/full_run/
!/logs/full_run/**
!/logs/full_run_setup/
!/logs/full_run_setup/**
# Local absolute-path alias and incomplete archives are not diagnostic evidence.
/logs/full_run/latest
/logs/full_run/**/*.part
/logs/full_run_setup/**/*.part

.run/
.runtime/
config/runtime.env
config/full_run.env
rosbag2_*/
*.db3
*.mcap

# Local hardware settings and large models
config/local.yaml
models/*.pt
models/*.onnx
models/*.engine

# IDE settings
.idea/
.vscode/
*.user
*.suo
