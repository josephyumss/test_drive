Panels:
  - Class: rviz_common/Displays
    Name: Displays
Visualization Manager:
  Class: ""
  Global Options:
    Background Color: 18; 18; 18
    Fixed Frame: base_laser
    Frame Rate: 30
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: Grid
      Enabled: true
      Cell Size: 0.5
    - Class: rviz_default_plugins/LaserScan
      Name: STL-27L Scan
      Enabled: true
      Topic:
        Value: /scan
      Size (Pixels): 4
      Style: Points
      Color: 0; 255; 80
Window Geometry:
  Width: 1000
  Height: 760
