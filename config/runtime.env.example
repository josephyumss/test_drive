# Copy this file to config/runtime.env and adjust only values that differ on the Jetson.
ROS_DISTRO=humble
MCU_DEVICE=/dev/ttyTHS1
LIDAR_DEVICE=/dev/ttyUSB_lidar
OAK_LAUNCH_PACKAGE=depthai_ros_driver
OAK_LAUNCH_FILE=camera.launch.py
VISION_MODE=docker
YOLO_DOCKER_IMAGE=socialguide-amr-oak-yolo:jp6
YOLO_WEB_URL=http://127.0.0.1:8081
LIDAR_LAUNCH_PACKAGE=ldlidar_stl_ros2
LIDAR_LAUNCH_FILE=stl27l.launch.py
LIDAR_SETUP_FILE=/home/kookminrobotics/ldlidar_ros2_ws/install/setup.bash
LIDAR_PORT_ARGUMENT=port_name
OPEN_GUI=1
OPEN_YOLO_WINDOW=1
OPEN_RVIZ=1
OPEN_DASHBOARD=1
