# Copy to config/full_run.env only if overriding the defaults.
# Mandatory wiring: STM32 USART1 RX <- Jetson THS1 TX;
# STM32 USART3 TX -> Jetson THS2 RX, and common GND.
MCU_DEVICE=/dev/ttyTHS1
MCU_STATUS_DEVICE=/dev/ttyTHS2
MCU_BAUDRATE=115200
# LIDAR_SETUP=/absolute/path/ldlidar_ros2_ws/install/setup.bash
# LIDAR_DEVICE=/dev/serial/by-id/your-lidar
# FULL_RUN_CONFIG=/absolute/path/config/full_run.json
YOLO_DEVICE=cpu
YOLO_IMGSZ=320
YOLO_HALF=0
