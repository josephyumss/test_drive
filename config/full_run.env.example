# Copy to config/full_run.env only if overriding the defaults.
# Existing firmware is used: no STM32 build/upload required.
# Commands: Jetson TX -> STM32 USART1 RX. Status: STM32 USART3 TX -> Jetson RX.
# ttyTHS2 is only a default device name, NOT a confirmed physical connector.
# Set MCU_STATUS_DEVICE to the real receiving UART (it may equal MCU_DEVICE).
MCU_PROTOCOL=legacy
MCU_DEVICE=/dev/ttyTHS1
MCU_STATUS_DEVICE=/dev/ttyTHS2
MCU_BAUDRATE=115200
# Orin Nano/Super GPIO fallback; detected device-tree models take precedence.
JETSON_MODEL_NAME=JETSON_ORIN_NANO
# LIDAR_SETUP=/absolute/path/ldlidar_ros2_ws/install/setup.bash
# LIDAR_DEVICE=/dev/serial/by-id/your-lidar
# FULL_RUN_CONFIG=/absolute/path/config/full_run.json
YOLO_DEVICE=cpu
YOLO_IMGSZ=320
YOLO_HALF=0
